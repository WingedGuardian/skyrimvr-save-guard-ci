+def _rd_interpreter_view(text):
+    """Retain shell syntax; distinguish only exact, statically bound Python code.
+
+    A single-quoted PowerShell here-string is recognized only as one complete
+    assignment plus one complete Python -c command. Extra statements, consumers,
+    expansion or unknown forms keep all original checks. The original command
+    and approval hash are not changed.
+    """
+    if len(text) > 524288 or not re.search(r'\brd\b', text, re.I):
+        return text
+    here = list(re.finditer(r"(?m)^[ \t]*(\$[A-Za-z_]\w*)[ \t]*=[ \t]*@'\r?\n(.*?)\r?\n'@[ \t]*$",
+                            text, re.S))
+    scan = text
+    for item in reversed(here):
+        scan = scan[:item.start(2)] + re.sub(r'[^\r\n]', ' ', item[2]) + scan[item.end(2):]
+    consumers = [_python_c_argument(segment) for segment, _ in split_segments(scan)]
+    edits = []
+    for item in (here if len(here) == 1 else ()):
+        variable = item[1]
+        remaining = (text[:item.start()] + text[item.end():]).strip()
+        segments = split_segments(remaining)
+        # Inspect the WHOLE outside program. Counting $name spellings cannot
+        # exclude ${name}, Get-Variable, aliases or another dynamic consumer.
+        if len(segments) == 1 and segments[0][0] == remaining \
+                and len(_split_on_ampersand(remaining)) == 1 \
+                and not _substitutions(remaining) and remaining.count('$') == 1 \
+                and _python_c_argument(remaining) == variable:
+            edits.append((item.start(2), item.end(2), _python_rd_view(item[2])))
+    # Direct literal -c payloads are recognized as one complete simple command.
+    # Only exact raw payload spans can be changed; escaping we cannot reproduce
+    # stays conservative rather than reconstructing another executable command.
+    for value in consumers:
+        if value and not value.startswith('$') and text.count(value) == 1:
+            start = text.find(value)
+            edits.append((start, start + len(value), _python_rd_view(value)))
+    for start, end, value in sorted(edits, reverse=True):
+        text = text[:start] + value + text[end:]
+    return text
+
