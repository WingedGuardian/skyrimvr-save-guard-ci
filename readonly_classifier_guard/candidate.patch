+def _python_rd_view(source):
+    """Only a tightly bound stdlib reader's NAME stops being the shell alias rd.
+
+    One module-local lambda must return json.loads(Path(p).read_bytes())
+    through explicit json/pathlib imports. Only direct calls may use the reader;
+    unknown bindings, callback escape, visible rebinding or execution sinks keep
+    the original classification. No path/string/other mutation token is removed.
+    This is a source classifier, not Python purity or hostile-code isolation.
+    """
+    if len(source) > 262144 or not re.search(r'\brd\b', source, re.I):
+        return source
+    sinks = {'exec', 'eval', 'compile', '__import__', 'getattr', 'globals', 'locals', 'vars',
+             'system', 'popen', 'run', 'call', 'Popen', 'check_call', 'check_output',
+             'execv', 'execve', 'execl', 'execlp', 'execvp', 'execvpe', 'spawnv', 'spawnve',
+             'spawnl', 'spawnlp', 'spawnvp', 'spawnvpe', 'startfile', 'load_module'}
+    try:
+        tree = ast.parse(source)
+        parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
+        definitions = []
+        for node in tree.body:
+            if isinstance(node, ast.Assign) and len(node.targets) == 1 \
+                    and isinstance(node.targets[0], ast.Name) and node.targets[0].id.lower() == 'rd' \
+                    and isinstance(node.value, ast.Lambda) and node.type_comment is None:
+                definitions.append((node, node.targets[0].id, node.value.args, node.value.body, node.targets[0]))
+        if len(definitions) != 1:
+            return source
+        definition, name, arguments, expression, binding_target = definitions[0]
+        if arguments.posonlyargs or len(arguments.args) != 1 or arguments.vararg or arguments.kwarg \
+                or arguments.kwonlyargs or arguments.defaults or arguments.kw_defaults \
+                or arguments.args[0].annotation is not None:
+            return source
+        parameter = arguments.args[0].arg
+        symbols, imports = {}, set()
+        for node in tree.body:
+            if (node.lineno, node.col_offset) >= (definition.lineno, definition.col_offset):
+                continue
+            if isinstance(node, ast.Import):
+                pairs = [(item, item.asname or item.name, item.name) for item in node.names
+                         if item.name in ('json', 'pathlib')]
+            elif isinstance(node, ast.ImportFrom) and node.level == 0:
+                pairs = [(item, item.asname or item.name, node.module + '.' + item.name) for item in node.names
+                         if (node.module, item.name) in (('json', 'loads'), ('pathlib', 'Path'))]
+            else:
+                continue
+            for item, alias, qualified in pairs:
+                if alias in symbols and symbols[alias] != qualified:
+                    return source
+                symbols[alias] = qualified
+                imports.add(item)
+
+        def qualified(node):
+            if isinstance(node, ast.Name):
+                return symbols.get(node.id)
+            if isinstance(node, ast.Attribute):
+                root = qualified(node.value)
+                return root + '.' + node.attr if root else None
+            return None
+
+        # Recognize exactly a standard-library read expression, never an opaque
+        # local function, decorated/default-expression binding or callback.
+        if not isinstance(expression, ast.Call) or qualified(expression.func) != 'json.loads' \
+                or len(expression.args) != 1 or expression.keywords:
+            return source
+        read = expression.args[0]
+        if not isinstance(read, ast.Call) or read.args or read.keywords \
+                or not isinstance(read.func, ast.Attribute) or read.func.attr != 'read_bytes':
+            return source
+        path = read.func.value
+        if not isinstance(path, ast.Call) or qualified(path.func) != 'pathlib.Path' \
+                or len(path.args) != 1 or path.keywords or not isinstance(path.args[0], ast.Name) \
+                or path.args[0].id != parameter or parameter in symbols or parameter.lower() == 'rd':
+            return source
+        used = {node.id for node in ast.walk(expression) if isinstance(node, ast.Name) and node.id in symbols}
+        protected = used
+
+        def target_roots(node):
+            if isinstance(node, ast.Name): return {node.id}
+            if isinstance(node, (ast.Attribute, ast.Subscript)): return target_roots(node.value)
+            if isinstance(node, ast.Starred): return target_roots(node.value)
+            if isinstance(node, (ast.Tuple, ast.List)):
+                return set().union(*(target_roots(item) for item in node.elts))
+            return set()
+
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Attribute) and (node.attr in sinks or node.attr.startswith(('exec', 'spawn'))):
+                return source
+            if isinstance(node, ast.ImportFrom) and any(item.name == '*' or item.name in sinks
+                    or item.name.startswith(('exec', 'spawn')) or (item.asname or item.name).lower() == 'rd'
+                    for item in node.names):
+                return source
+            if isinstance(node, (ast.Import, ast.ImportFrom)) and any(
+                    (item.asname or item.name.split('.')[0]) in protected and item not in imports
+                    for item in node.names):
+                return source
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) \
+                    and node.name in protected and node is not definition:
+                return source
+            if isinstance(node, (ast.Global, ast.Nonlocal)) and protected.intersection(node.names):
+                return source
+            if isinstance(node, (ast.ExceptHandler, ast.MatchAs, ast.MatchStar)) and node.name in protected:
+                return source
+            if isinstance(node, ast.MatchMapping) and node.rest in protected:
+                return source
+            if isinstance(node, ast.arg) and node.arg in protected:
+                return source  # A runtime-supplied callable is not this local binding.
+            if isinstance(node, ast.Name) and node.id in protected:
+                parent = parents.get(node)
+                if isinstance(node.ctx, ast.Load):
+                    direct = isinstance(parent, ast.Call) and parent.func is node
+                    if not (direct or isinstance(parent, ast.Attribute)):
+                        return source  # Standard-library binding escaped to an unknown consumer.
+                elif node is not binding_target:
+                    return source
+            if isinstance(node, ast.Attribute) and target_roots(node) & used:
+                parent = parents.get(node)
+                if not ((isinstance(parent, ast.Call) and parent.func is node)
+                        or (isinstance(parent, ast.Attribute) and parent.value is node)):
+                    return source
+            if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign, ast.NamedExpr, ast.Delete)):
+                targets = node.targets if isinstance(node, (ast.Assign, ast.Delete)) else [node.target]
+                if node is not definition and any(target_roots(target) & protected for target in targets):
+                    return source
+            if isinstance(node, ast.Call):
+                if not isinstance(node.func, (ast.Name, ast.Attribute)):
+                    return source
+                if isinstance(node.func, ast.Name) and node.func.id in sinks:
+                    return source
+        lines = source.splitlines(keepends=True)
+        offsets, total = [], 0
+        for line in lines:
+            offsets.append(total)
+            total += len(line)
+        def span(node):
+            # AST columns count UTF-8 bytes; tokenize columns count characters.
+            def position(row, column):
+                return offsets[row - 1] + len(lines[row - 1].encode('utf-8')[:column].decode('utf-8'))
+            return position(node.lineno, node.col_offset), position(node.end_lineno, node.end_col_offset)
+        allowed = {span(binding_target)}
+        allowed.update(span(node.func) for node in ast.walk(tree) if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name) and node.func.id == name)
+        edits = []
+        for token in tokenize.generate_tokens(io.StringIO(source).readline):
+            if token.type == tokenize.NAME and token.string.lower() == 'rd':
+                location = (offsets[token.start[0] - 1] + token.start[1],
+                            offsets[token.end[0] - 1] + token.end[1])
+                if location not in allowed:
+                    return source  # Attribute/keyword/store/capture/escape is not a direct reader use.
+                edits.append(location)
+        for start, end in reversed(edits):
+            source = source[:start] + '_' * (end - start) + source[end:]
+        return source
+    except (SyntaxError, ValueError, TypeError, UnicodeError, tokenize.TokenError,
+            IndentationError, IndexError, RecursionError):
+        return source
+
