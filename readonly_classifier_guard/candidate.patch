+def _static_node_report_target(tool, args):
+    """One plain-data assignment and one literal fs.writeFile destination.
+
+    This intentionally small grammar is not general JavaScript parsing. It
+    evaluates nothing and recognizes no expressions/getters/templates/calls in
+    data. An unmatched program goes through all existing conservative rules.
+    """
+    if tool != 'mcp__node_repl__js' or not isinstance(args, dict) or type(args.get('code')) is not str \
+            or not set(args) <= {'code', 'title'} or ('title' in args and type(args['title']) is not str):
+        return None
+    code = args['code']
+    if len(code) > 65536:
+        return None
+    token_re = re.compile(r'''\s+|(?P<string>'(?:[^'\\\r\n]|\\.)*'|"(?:[^"\\\r\n]|\\.)*")|'''
+                          r'(?P<number>-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)|'
+                          r'(?P<name>[A-Za-z_$][A-Za-z0-9_$]*)|(?P<punct>[{}\[\]():;,\.=])')
+    tokens, pos = [], 0
+    for found in token_re.finditer(code):
+        if found.start() != pos:
+            return None
+        pos = found.end()
+        if not found.group().isspace():
+            tokens.append((found.lastgroup, found.group()))
+    if pos != len(code) or len(tokens) > 10000:
+        return None
+
+    def string(raw):
+        out, index = [], 1
+        escapes = {'b': '\b', 'f': '\f', 'n': '\n', 'r': '\r', 't': '\t',
+                   '\\': '\\', '/': '/', '"': '"', "'": "'"}
+        while index < len(raw) - 1:
+            char = raw[index]; index += 1
+            if char == '\\':
+                char = raw[index]; index += 1
+                if char == 'u':
+                    digits = raw[index:index + 4]
+                    if not re.fullmatch('[0-9a-fA-F]{4}', digits):
+                        raise ValueError('Unsupported escape')
+                    char = chr(int(digits, 16)); index += 4
+                else:
+                    char = escapes[char]
+            if ord(char) < 32 or 0xd800 <= ord(char) <= 0xdfff:
+                raise ValueError('Unsupported literal character')
+            out.append(char)
+        return ''.join(out)
+
+    index = 0
+    def take(value):
+        nonlocal index
+        if index >= len(tokens) or tokens[index][1] != value:
+            raise ValueError('Unsupported report grammar')
+        index += 1
+
+    def literal(depth=0):
+        nonlocal index
+        if depth > 24 or index >= len(tokens):
+            raise ValueError('Bounded plain data required')
+        kind, value = tokens[index]
+        if kind == 'string':
+            index += 1; return string(value)
+        if kind == 'number' or value in ('true', 'false', 'null'):
+            index += 1; return None
+        if value == '[':
+            take('[')
+            if tokens[index][1] != ']':
+                while True:
+                    literal(depth + 1)
+                    if tokens[index][1] != ',': break
+                    take(',')
+            take(']'); return None
+        if value == '{':
+            take('{'); fields = {}
+            if tokens[index][1] != '}':
+                while True:
+                    kind, key = tokens[index]
+                    if kind == 'string': key = string(key)
+                    elif kind != 'name': raise ValueError('Plain key required')
+                    if key in fields or key in ('__proto__', 'constructor', 'prototype'):
+                        raise ValueError('Unsupported object key')
+                    index += 1; take(':'); fields[key] = literal(depth + 1)
+                    if tokens[index][1] != ',': break
+                    take(',')
+            take('}'); return fields
+        raise ValueError('No report expressions')
+
+    try:
+        if not tokens or tokens[index][1] not in ('var', 'let', 'const'):
+            return None
+        index += 1
+        kind, variable = tokens[index]
+        if kind != 'name' or variable in ('fs', 'JSON', 'await', 'var', 'let', 'const'):
+            return None
+        index += 1; take('=')
+        if tokens[index][1] not in ('{', '['): return None
+        literal(); take(';'); take('await'); take('fs'); take('.'); take('writeFile'); take('(')
+        kind, raw = tokens[index]
+        if kind != 'string': return None
+        target = string(raw); index += 1
+        if not is_abs(target) or any(char in target for char in '$`%{}*?[]\r\n\0'):
+            return None
+        take(','); take('JSON'); take('.'); take('stringify'); take('('); take(variable)
+        take(','); take('null'); take(','); take('2'); take(')'); take(',')
+        options = literal()
+        if options != {'flag': 'wx'}: return None
+        take(')')
+        if index < len(tokens): take(';')
+        return target if index == len(tokens) else None
+    except (ValueError, KeyError, IndexError, RecursionError):
+        return None
 
 
