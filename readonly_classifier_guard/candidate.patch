+def _python_c_argument(segment):
+    """Literal -c argument, optionally through the existing exact rb run grammar."""
+    words = _without_redirects(_shell_words(segment))[0]
+    name, args = _command_of(words)
+    if not re.fullmatch(r'(?:python(?:\d+(?:\.\d+)*)?|py)', name, re.I):
+        return None
+
+    def flags(rest):
+        rest = list(rest)
+        while rest and rest[0] in ('-B', '-E', '-s', '-S', '-u', '-I'):
+            rest.pop(0)
+        return rest
+
+    args = flags(args)
+    if args[:1] == ['-c'] and len(args) == 2:
+        return args[1]
+    if len(args) < 4 or args[1:2] != ['run']:
+        return None
+    try:
+        runner = Path(msys_fix(args[0]))
+        if not runner.is_absolute() or runner.resolve() != (Path.home() / '.claude/tools/resource-budget/rb.py').resolve():
+            return None
+        divider = args.index('--', 2)
+    except (OSError, ValueError):
+        return None
+    options = args[2:divider]
+    if len(options) % 2 or any(options[i] not in ('--name', '--cpu', '--ram', '--disk', '--cpu-cap',
+            '--mem-cap', '--priority', '--wait-until-fits') for i in range(0, len(options), 2)):
+        return None
+    child, rest = _command_of(args[divider + 1:])
+    rest = flags(rest)
+    if re.fullmatch(r'(?:python(?:\d+(?:\.\d+)*)?|py)', child, re.I) \
+            and rest[:1] == ['-c'] and len(rest) == 2:
+        return rest[1]
+    return None
