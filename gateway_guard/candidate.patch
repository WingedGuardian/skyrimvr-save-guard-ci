+    acted = (any(k == 'action' and v in RUNTIME_ACTIONS for k, v in pairs) or bool(RUNTIME_TOKEN.search(t))
+             or bool(RUNTIME_FILE_BODY.search(t)))
+    return aimed and acted
 
 
