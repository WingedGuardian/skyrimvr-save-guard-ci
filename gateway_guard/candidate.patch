+    values = RSYNC_VALUE_FLAGS if name == 'rsync' else SCP_VALUE_FLAGS
+    operands, written, remove_source, i = [], [], False, 0
+    while i < len(args):
+        w = args[i]
+        i += 1
+        if w.startswith('-') and len(w) > 1:
+            flag, eq, value = w.partition('=')
