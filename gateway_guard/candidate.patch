+        c = text[i]
+        if c == "'" and quote != '"':
+            quote = None if quote == "'" else "'"
+        elif quote == "'":
+            pass
+        elif c == '"':
+            quote = None if quote == '"' else '"'
+        elif c == '`' and (end := text.find('`', i + 1)) > i:
+            found.append(text[i + 1:end])
+            i = end
+        elif text.startswith('$(', i):
+            depth, j = 1, i + 2
+            while j < len(text) and depth:
+                depth += {'(': 1, ')': -1}.get(text[j], 0)
+                j += 1
+            found.append(text[i + 2:j - 1])
